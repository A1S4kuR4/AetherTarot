{
  "name": "@aethertarot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-share-font.js",
    "dev": "node ./scripts/run-next.cjs dev",
    "prebuild": "node scripts/copy-share-font.js",
    "build": "node ./scripts/run-next.cjs build",
    "start": "node ./scripts/run-next.cjs start",
    "lint": "eslint",
    "eval:reading": "vite-node --config vitest.config.ts src/server/reading/evals/runner.ts",
    "test:contract": "vitest run",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "canary:llm": "vite-node --config vitest.config.ts scripts/run-llm-canary.ts",
    "eval:export-feedback": "vite-node --config vitest.config.ts scripts/export-feedback-replay.ts",
    "eval:review": "vite-node --config vitest.config.ts scripts/quality-review.ts",
    "eval:reading-staged-ab": "vite-node --config vitest.config.ts scripts/run-staged-reading-ab.ts",
    "test:a11y:reading": "playwright test --project=chromium tests/reading-accessibility.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aethertarot/domain-tarot": "0.1.0",
    "@aethertarot/prompting": "0.1.0",
    "@aethertarot/shared-types": "0.1.0",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-virtual": "^3.14.2",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chinese-fonts/syst": "^3.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "lighthouse": "^12.8.2",
    "playwright-lighthouse": "^4.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0",
    "@rollup/rollup-linux-x64-gnu": "^4.61.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2"
  }
}
