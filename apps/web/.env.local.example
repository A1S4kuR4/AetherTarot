# Safe local development (default for `npm run dev`)
# No Supabase CLI/container is required. Local-only mode is ignored in production.
AETHERTAROT_LOCAL_ONLY=1
AUTH_SECRET=  # 本地 dev 有安全占位默认值；生产环境必须单独设置

# Optional integrated database development (set AETHERTAROT_LOCAL_ONLY=0 explicitly)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI (future use)
DEEPSEEK_API_KEY=your_deepseek_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Providers: keep model calls disabled until supplier hard budget protection is verified
AETHERTAROT_READING_PROVIDER=placeholder
AETHERTAROT_ENCYCLOPEDIA_PROVIDER=disabled
# Rollback-safe Reading generation policy. Production default remains monolithic.
AETHERTAROT_READING_GENERATION_MODE=monolithic

# Optional llm baseline (OpenAI-compatible / DashScope-compatible)

AETHERTAROT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AETHERTAROT_LLM_MODEL=qwen3.6-flash
AETHERTAROT_LLM_API_KEY=$DASHSCOPE_API_KEY
AETHERTAROT_LLM_TEMPERATURE=0.3
AETHERTAROT_LLM_THINKING_MODE=disabled
AETHERTAROT_LLM_RESPONSE_FORMAT=json_object
AETHERTAROT_LLM_TIMEOUT_MS=120000
AETHERTAROT_LLM_MAX_OUTPUT_TOKENS=1800
AETHERTAROT_LLM_MAX_RESPONSE_BYTES=1048576
AETHERTAROT_LLM_MAX_CONCURRENCY=4
AETHERTAROT_LLM_MAX_QUEUE=16
AETHERTAROT_LLM_QUEUE_TIMEOUT_MS=15000
AETHERTAROT_LLM_INPUT_COST_PER_1K_USD=0.001
AETHERTAROT_LLM_OUTPUT_COST_PER_1K_USD=0.002

# Stateless LLM Safety Reviewer. `off` is local-only; production readiness accepts
# only `shadow` or `enforce`. Keep independent config/capacity controls; the API key
# may explicitly reference the generation key when both calls use the same provider.
AETHERTAROT_SAFETY_REVIEWER_MODE=off
AETHERTAROT_SAFETY_REVIEWER_BASE_URL=https://reviewer-provider.example/v1
AETHERTAROT_SAFETY_REVIEWER_MODEL=reviewer-model-version
AETHERTAROT_SAFETY_REVIEWER_API_KEY=$AETHERTAROT_LLM_API_KEY
AETHERTAROT_SAFETY_REVIEWER_POLICY_VERSION=safety-reviewer-v1
AETHERTAROT_SAFETY_REVIEWER_DAILY_TOKEN_LIMIT=30000
AETHERTAROT_SAFETY_REVIEWER_RATE_LIMIT_PER_MINUTE=120
# Per-subject/IP reviewer capacity, enforced by Supabase across all web instances.
AETHERTAROT_SAFETY_REVIEWER_SUBJECT_RATE_LIMIT_PER_MINUTE=12
AETHERTAROT_SAFETY_REVIEWER_MAX_CONCURRENCY=2
AETHERTAROT_SAFETY_REVIEWER_MAX_QUEUE=4
AETHERTAROT_SAFETY_REVIEWER_QUEUE_TIMEOUT_MS=300
AETHERTAROT_SAFETY_REVIEWER_INPUT_DEADLINE_MS=1800
AETHERTAROT_SAFETY_REVIEWER_OUTPUT_DEADLINE_MS=2500
AETHERTAROT_SAFETY_REVIEWER_MAX_OUTPUT_TOKENS=192
AETHERTAROT_SAFETY_REVIEWER_MAX_RESPONSE_BYTES=32768
AETHERTAROT_SAFETY_REVIEWER_CIRCUIT_FAILURE_THRESHOLD=3
AETHERTAROT_SAFETY_REVIEWER_CIRCUIT_RESET_MS=30000
AETHERTAROT_SAFETY_REVIEWER_CACHE_TTL_MS=30000
AETHERTAROT_SAFETY_REVIEWER_CACHE_HMAC_SECRET=replace_with_independent_random_secret

# Beta access, quota, and observability
AETHERTAROT_READING_DAILY_LIMIT_PER_USER=10
AETHERTAROT_READING_DAILY_LIMIT_PER_ANONYMOUS_IP=3
AETHERTAROT_ENCYCLOPEDIA_DAILY_LIMIT_PER_USER=20
AETHERTAROT_ENCYCLOPEDIA_DAILY_LIMIT_PER_ANONYMOUS_IP=1
AETHERTAROT_LLM_IP_LIMIT_PER_MINUTE=6
AETHERTAROT_LLM_DAILY_TOKEN_LIMIT=200000
AETHERTAROT_IP_HASH_SALT=replace_with_random_secret
# Caddy overwrites the matching internal request header with this secret.
AETHERTAROT_PROXY_SHARED_SECRET=replace_with_a_different_random_secret

# LangSmith (future use)
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=aether-tarot
