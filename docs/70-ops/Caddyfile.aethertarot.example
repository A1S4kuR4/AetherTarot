{
  servers {
    strict_sni_host on
    timeouts {
      read_header 10s
      read_body 30s
      idle 2m
    }
  }
}

(aethertarot_proxy) {
  request_header -CF-Connecting-IP
  request_header -X-Forwarded-For
  request_header -X-Real-IP
  request_header -X-AetherTarot-Client-IP
  request_header -X-AetherTarot-Proxy-Secret
  request_header X-AetherTarot-Client-IP {remote_host}
  request_header X-AetherTarot-Proxy-Secret {$AETHERTAROT_PROXY_SHARED_SECRET}
  reverse_proxy 127.0.0.1:3000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 130s
      read_timeout 140s
      write_timeout 15s
    }
  }
}

# Port 80 redirects only the production hostnames. Raw IP and unknown Host fail.
http://aethertarot.cn, http://www.aethertarot.cn {
  redir https://aethertarot.cn{uri} permanent
}

http:// {
  respond "unrecognized host" 421
}

# The canonical HTTPS host is apex; www never reaches the application.
https://www.aethertarot.cn {
  redir https://aethertarot.cn{uri} permanent
}

https://aethertarot.cn {
  encode zstd gzip

  # The migration endpoint keeps its documented 2 MiB contract. Ordinary API
  # routes are capped at 256 KiB; the reading route has a tighter 64 KiB cap.
  handle /api/readings/migrate {
    request_body {
      max_size 2MiB
    }
    import aethertarot_proxy
  }
  handle /api/reading {
    request_body {
      max_size 64KiB
    }
    import aethertarot_proxy
  }
  handle /api/* {
    request_body {
      max_size 256KiB
    }
    import aethertarot_proxy
  }
  handle {
    import aethertarot_proxy
  }
}
